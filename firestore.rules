rules_version = '2';

// 글(posts)은 공개 글만 누구나 읽을 수 있고, 쓰기·고치기·지우기는 관리자만 할 수 있어요.
// 관리자는 로그인 정보에 admin 표시(custom claim)가 붙은 계정 한 명이에요.
// 평가자는 임시 접속 코드로 들어온 계정이에요(reviewer 표시와 만료 시각 until이 붙어요). 만료 전까지는 관리자 화면을 보고
// 쓸 수 있지만, 글·조회수·댓글을 지우는 것은 관리자만 할 수 있어요.
// 나만 보기 메뉴(예: 회고)의 글은 항상 나만 보기(private)여야 하고, 관리자만 읽을 수 있어요.
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 표시가 없는 계정(일반 방문자)에서도 오류가 나지 않고 false가 되도록 get()으로 읽어요.
    // token.admin으로 바로 읽으면 표시가 없는 계정에서 오류가 되어, 댓글 쓰기처럼 isAdmin()을 호출하는 규칙이 통째로 거부돼요.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // 관리자이거나, 만료 전의 평가자예요. 읽기·쓰기에 써요. 지우기는 isAdmin()만 써요.
    function isStaff() {
      return request.auth != null && (request.auth.token.get('admin', false) == true
        || (request.auth.token.get('reviewer', false) == true && request.auth.token.get('until', 0) > request.time.toMillis()));
    }

    // 나만 보기로 정한 메뉴 목록(관리자만 읽는 settings/private 문서에 들어 있어요).
    function privSlugs() {
      return get(/databases/$(database)/documents/settings/private).data.slugs;
    }

    // 공개 글에는 자리표시자("[이름]" 등)와 휴대전화 번호를 넣을 수 없어요. (assets/check.js의 "해결 필요" 규칙과 같아요)
    // 화면의 점검을 건너뛰고 저장하려 해도 여기서 한 번 더 막아요.
    function publishable(b) {
      return !b.matches('[\\s\\S]*\\[(이름|샘플|이메일 주소)[^\\]]*\\][\\s\\S]*')
        && !b.matches('[\\s\\S]*(^|[^0-9])01[016789][-. ]?[0-9]{3,4}[-. ]?[0-9]{4}([^0-9]|$)[\\s\\S]*');
    }

    function validPost(d) {
      return d.keys().hasOnly(['title', 'slug', 'category', 'visibility', 'summary', 'description', 'body', 'format', 'thumb', 'img', 'files', 'date', 'aiSummary', 'aiSummaryOn', 'aiSummaryFor', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.slug is string && d.slug.size() <= 80 && (d.slug == '' || d.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$'))
        && d.category is string && d.category.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && d.category.size() <= 40
        && d.visibility in ['public', 'private']
        && (d.category != 'retrospective' || d.visibility == 'private')
        && (d.visibility == 'private' || !(d.category in privSlugs()))
        && d.summary is string && d.summary.size() <= 300
        && d.description is string && d.description.size() <= 300
        && d.body is string && d.body.size() > 0 && d.body.size() <= 100000
        && (!('format' in d) || d.format in ['md', 'html'])
        && (!('thumb' in d) || (d.thumb is int && d.thumb >= -1 && d.thumb < 6))
        && (!('img' in d) || (d.img is string && d.img.size() <= 800 && (d.img == '' || d.img.matches('^https://firebasestorage\\.googleapis\\.com/.*'))))
        && (!('files' in d) || (d.files is list && d.files.size() <= 5))
        && (!('aiSummary' in d) || (d.aiSummary is list && d.aiSummary.size() <= 3))
        && (!('aiSummaryOn' in d) || d.aiSummaryOn is bool)
        && (!('aiSummaryFor' in d) || (d.aiSummaryFor is string && d.aiSummaryFor.size() <= 20))
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (d.visibility == 'private' || publishable(d.body))
        && d.createdAt is timestamp && d.updatedAt is timestamp;
    }

    match /posts/{postId} {
      allow read: if isStaff() || resource.data.visibility == 'public';
      allow create: if isStaff() && validPost(request.resource.data);
      allow update: if isStaff() && validPost(request.resource.data);
      allow delete: if isAdmin();
    }

    // 조회수: 누구나 읽을 수 있고, 공개 글의 숫자만 1씩 올릴 수 있어요. 나만 보기 메뉴의 글에는 만들 수 없어요.
    // (같은 사람이 새로고침으로 올리는 것은 이 브라우저에서 한 번만 세는 것으로 줄였어요. 완전히 막지는 못해요.)
    function viewable(id) {
      return id.matches('^md-[a-z0-9-]+$')
        || (exists(/databases/$(database)/documents/posts/$(id))
            && get(/databases/$(database)/documents/posts/$(id)).data.visibility == 'public');
    }
    match /views/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1 && viewable(id);
      allow update: if request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == resource.data.count + 1 && viewable(id);
      allow delete: if isAdmin();
    }

    // 댓글: 누구나 읽을 수 있어요. 구글로 로그인한 사람만 쓰고, 쓴 사람만 내용을 고치고,
    // 쓴 사람과 관리자만 지울 수 있어요. 공개 글에만 쓸 수 있고, 나만 보기 글(회고)에는 쓸 수 없어요.
    // 이름만 저장하고 이메일은 저장하지 않아요. "관리자" 이름과 관리자 표시는 관리자만 쓸 수 있어요.
    function validMentions(m) {
      return m is list && m.size() <= 10;
    }
    function validNewComment(d) {
      return d.keys().hasOnly(['post', 'parent', 'uid', 'name', 'admin', 'text', 'mentions', 'createdAt'])
        && d.post is string && d.post.size() > 0 && d.post.size() <= 60 && viewable(d.post)
        && d.parent is string && d.parent.size() <= 60
        && (d.parent == '' || get(/databases/$(database)/documents/comments/$(d.parent)).data.post == d.post)
        && d.uid == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40 && (d.name != '관리자' || isAdmin())
        && d.admin == isAdmin()
        && d.text is string && d.text.size() > 0 && d.text.size() <= 500
        && validMentions(d.mentions)
        && d.createdAt == request.time;
    }
    match /comments/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com' && validNewComment(request.resource.data);
      allow update: if request.auth != null && (
        // 쓴 사람이 내용 고치기
        (resource.data.uid == request.auth.uid && resource.data.get('gone', false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'mentions'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && validMentions(request.resource.data.mentions)
          && request.resource.data.editedAt == request.time)
        // 답글이 달린 댓글을 지울 때: 내용을 비우고 삭제 표시만 해요(쓴 사람 또는 관리자)
        || ((resource.data.uid == request.auth.uid || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'gone', 'mentions'])
          && request.resource.data.gone == true && request.resource.data.text == ''
          && validMentions(request.resource.data.mentions))
      );
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // AI 기능 기록: 관리자만 읽고 남길 수 있어요. 글 내용은 저장하지 않고 종류·글 번호·횟수·건수만 남겨요.
    match /aiLogs/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.keys().hasOnly(['kind', 'feature', 'post', 'at', 'n'])
        && request.resource.data.kind in ['suggest', 'apply', 'ignore', 'gate', 'fail', 'foundbad', 'foundwarn', 'ack']
        && (!('n' in request.resource.data) || (request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 50))
        && request.resource.data.feature is string && request.resource.data.feature.size() <= 20
        && request.resource.data.post is string && request.resource.data.post.size() <= 60
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // 이번 달 AI 호출 횟수: 서버 함수만 쓰고(관리자 권한), 관리자는 읽기만 해요.
    match /aiUsage/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // 공개 메뉴 이름은 누구나 읽을 수 있고(사이트를 만들 때 써요), 고치는 건 관리자만 해요.
    match /settings/menus {
      allow read: if true;
      allow write: if isStaff();
    }

    // 나만 보기 메뉴 이름 같은 설정은 관리자만 읽고 써요.
    match /settings/{docId} {
      allow read, write: if isStaff();
    }

    // 평가자 접속 코드(reviewerAccess)는 서버 함수만 읽고 써요. 화면에서는 누구도(관리자도) 열 수 없어요.
    // 그 밖의 모든 곳은 막아요.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
