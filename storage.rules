rules_version = '2';

// 썸네일(thumbs/)과 글 본문 이미지(images/): 누구나 볼 수 있고, 올리고 지우는 건 관리자만 해요.
// PNG·JPG·WebP·GIF만, 10MB 이하만 받아요. (SVG는 안에 코드가 들어갈 수 있어서 받지 않아요.)
service firebase.storage {
  match /b/{bucket}/o {
    match /{folder}/{file} {
      allow read: if (folder == 'thumbs' || folder == 'images');
      allow create: if (folder == 'thumbs' || folder == 'images')
        && request.auth != null && request.auth.token.admin == true
        && request.resource.size <= 10485760
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow delete: if (folder == 'thumbs' || folder == 'images') && request.auth != null && request.auth.token.admin == true;
      allow update: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
